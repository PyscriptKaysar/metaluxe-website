---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/CtaSectionAR.astro';

// The Catalog Items
const galleryItems = [
  // MACHINING - الخراطة
  { category: "machining", title: "تروس دقيقة", image: "/images/gears.png", desc: "تروس وعجلات مسننة مخصصة." },
  { category: "machining", title: "وصلات الأعمدة", image: "/images/shaft.png", desc: "وصلات أعمدة صناعية." },
  { category: "machining", title: "بكرات نايلون", image: "/images/nylonroller.png", desc: "جميع أنواع بكرات النايلون." },
  { category: "machining", title: "سلوتة الأنابيب", image: "/images/pipethreading.png", desc: "سلوتة وقلاووظ أنابيب دقيقة." },
  { category: "machining", title: "قطع غيار الماكينات", image: "/images/machineryparts.png", desc: "قطع غيار مخصصة." },

  // FITTINGS & SUPPLIES - التجهيزات
  { category: "fittings", title: "وصلات هيدروليكية", image: "/images/hydraulic.png", desc: "وصلات ضغط عالي هيدروليكية." },
  { category: "fittings", title: "تجهيزات حقول النفط", image: "/images/oilfieldfittings.png", desc: "مكونات متخصصة لحقول النفط." },
  { category: "fittings", title: "حلقات دائرية (O-Rings)", image: "/images/Orings.png", desc: "حلقات مطاطية صناعية." },
  { category: "fittings", title: "جوانات", image: "/images/Gaskets.png", desc: "جوانات مقطوعة حسب الطلب." },
  { category: "fittings", title: "أنابيب EPDM", image: "/images/epdmtube.png", desc: "أنابيب EPDM متينة." },
  { category: "fittings", title: "أغطية مطاطية", image: "/images/Rubberends.png", desc: "أغطية حماية نهائية." },
  { category: "fittings", title: "ألوحة الفتحات (Orifice)", image: "/images/orificeplate.png", desc: "ألوحة التحكم في التدفق." },
  { category: "fittings", title: "زنبركات صناعية", image: "/images/springs.png", desc: "زنبركات شد وضغط مخصصة." },

  // FABRICATION - التصنيع
  { category: "fabrication", title: "بوابات فولاذية", image: "/images/steelgate.png", desc: "بوابات وشبكات فولاذية معمارية." },
  { category: "fabrication", title: "لوحات السلامة", image: "/images/safety signs.png", desc: "لوحات إرشادية للسلامة الصناعية." },
  { category: "fabrication", title: "لوحات هيكلية", image: "/images/structuralsignboards.png", desc: "لوحات إعلانية وهيكلية ثقيلة." },
  { category: "fabrication", title: "منتجات العرض", image: "/images/displayproducts.jpg", desc: "حوامل عرض مخصصة للمتاجر والمعارض." },

  // CASTING - السباكة
  { category: "casting", title: "أعمال المسبك", image: "/images/foundry works.png", desc: "سباكة الرمل والقوالب." },
  { category: "casting", title: "سباكة المعادن", image: "/images/metal casting.png", desc: "مكونات معدنية مخصصة." },
  { category: "casting", title: "منتجات السباكة", image: "/images/casting.jpg", desc: "منتجات مصبوبة جاهزة." },
  { category: "casting", title: "أوزان المعايرة", image: "/images/calibration.png", desc: "أوزان معايرة دقيقة." },
];
---

<Layout title="معرض الإنتاج" lang="ar">
	
	<!-- HERO -->
	<section class="bg-primary pt-32 pb-12 text-center border-b border-gray-800">
		<div class="container mx-auto px-4">
			<h1 class="text-4xl md:text-5xl font-bold text-white mb-4 uppercase tracking-wider">
				معرض <span class="text-accent">الإنتاج</span>
			</h1>
			<p class="text-gray-400 max-w-2xl mx-auto">
				تصفح مجموعتنا المتنوعة من المكونات المصنعة وأعمال التصنيع والهياكل.
			</p>
		</div>
	</section>

	<!-- GALLERY GRID -->
	<section class="py-20 bg-primary-light min-h-screen">
		<div class="container mx-auto px-4">
			
			<!-- Filters -->
			<div class="grid grid-cols-6 gap-2 md:flex md:flex-wrap md:justify-center md:gap-4 mb-12">
				<button class="col-span-2 filter-btn active px-2 md:px-6 py-2 rounded-full border border-accent text-accent font-bold text-xs md:text-sm uppercase transition w-full md:w-auto" data-filter="all">الكل</button>
				<button class="col-span-2 filter-btn px-2 md:px-6 py-2 rounded-full border border-gray-600 text-gray-300 hover:border-accent hover:text-accent font-bold text-xs md:text-sm uppercase transition w-full md:w-auto" data-filter="machining">الخراطة</button>
				<button class="col-span-2 filter-btn px-2 md:px-6 py-2 rounded-full border border-gray-600 text-gray-300 hover:border-accent hover:text-accent font-bold text-xs md:text-sm uppercase transition w-full md:w-auto" data-filter="fittings">التجهيزات</button>
				<button class="col-span-2 col-start-2 filter-btn px-2 md:px-6 py-2 rounded-full border border-gray-600 text-gray-300 hover:border-accent hover:text-accent font-bold text-xs md:text-sm uppercase transition w-full md:w-auto" data-filter="fabrication">التصنيع</button>
				<button class="col-span-2 filter-btn px-2 md:px-6 py-2 rounded-full border border-gray-600 text-gray-300 hover:border-accent hover:text-accent font-bold text-xs md:text-sm uppercase transition w-full md:w-auto" data-filter="casting">السباكة</button>
			</div>

			<!-- Grid -->
			<div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-8">
				{galleryItems.map((item) => (
					<div class="gallery-item group relative rounded-lg bg-gray-900 border border-gray-800 overflow-hidden" data-category={item.category}>
						<div class="aspect-video overflow-hidden">
							<img src={item.image} alt={item.title} class="w-full h-full object-cover transition duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100" />
						</div>
						<div class="p-4 border-t border-gray-800 text-right">
							<h4 class="text-lg font-bold text-white">{item.title}</h4>
							<p class="text-xs text-gray-400 mt-1">{item.desc}</p>
						</div>
					</div>
				))}
			</div>

		</div>
	</section>

    <CtaSection />

</Layout>

<script>
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.gallery-item');

    buttons.forEach(btn => {
        btn.addEventListener('click', () => {
            buttons.forEach(b => {
                b.classList.remove('text-accent', 'border-accent');
                b.classList.add('text-gray-300', 'border-gray-600');
            });
            btn.classList.add('text-accent', 'border-accent');
            btn.classList.remove('text-gray-300', 'border-gray-600');

            const filter = btn.getAttribute('data-filter');
            items.forEach(item => {
                if (filter === 'all' || item.getAttribute('data-category') === filter) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
        });
    });
</script>
