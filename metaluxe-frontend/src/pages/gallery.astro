---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';

// The Catalog Items
const galleryItems = [
  // MACHINING
  { category: "machining", title: "Precision Gears", image: "/images/gears.png", desc: "Custom spur gears and sprockets." },
  { category: "machining", title: "Shaft Couplings", image: "/images/shaft.png", desc: "Industrial shaft couplings." },
  { category: "machining", title: "Nylon Rollers", image: "/images/nylonroller.png", desc: "All types of nylon rollers." },
  { category: "machining", title: "Pipe Threading", image: "/images/pipethreading.png", desc: "Precision pipe threading." },
  { category: "machining", title: "Machinery Parts", image: "/images/machineryparts.png", desc: "Custom spare parts." },

  // FITTINGS & SUPPLIES
  { category: "fittings", title: "Hydraulic Fittings", image: "/images/hydraulic.png", desc: "High-pressure hydraulic connections." },
  { category: "fittings", title: "Oilfield Fittings", image: "/images/oilfieldfittings.png", desc: "Specialized oilfield components." },
  { category: "fittings", title: "O-Rings", image: "/images/Orings.png", desc: "Industrial rubber O-rings." },
  { category: "fittings", title: "Gaskets", image: "/images/Gaskets.png", desc: "Custom cut gaskets." },
  { category: "fittings", title: "EPDM Hose Tubes", image: "/images/epdmtube.png", desc: "Durable EPDM tubing." },
  { category: "fittings", title: "Rubber End Caps", image: "/images/Rubberends.png", desc: "Protective end caps." },
  { category: "fittings", title: "Orifice Plates", image: "/images/orificeplate.png", desc: "Flow control plates." },
  { category: "fittings", title: "Industrial Springs", image: "/images/springs.png", desc: "Custom tension/compression springs." },

  // FABRICATION
  { category: "fabrication", title: "Steel Gates", image: "/images/steelgate.png", desc: "Architectural steel gates and grills." },
  { category: "fabrication", title: "Safety Signs", image: "/images/safety signs.png", desc: "Industrial safety signage." },
  { category: "fabrication", title: "Structural Sign Boards", image: "/images/structuralsignboards.png", desc: "Heavy-duty structural signs." },
  { category: "fabrication", title: "Display Products", image: "/images/displayproducts.jpg", desc: "Custom retail & exhibition display stands." },
  // CASTING
  { category: "casting", title: "Foundry Works", image: "/images/foundry works.png", desc: "Sand casting and molding." },
  { category: "casting", title: "Metal Casting", image: "/images/metal casting.png", desc: "Custom metal components." },
  { category: "casting", title: "Casting Products", image: "/images/casting.jpg", desc: "Finished cast products." },
  { category: "casting", title: "Calibration Scales", image: "/images/calibration.png", desc: "Precision calibration weights." },
];
---

<Layout title="Production Gallery">
	
	<!-- HERO -->
	<section class="bg-primary pt-32 pb-12 text-center border-b border-gray-800">
		<div class="container mx-auto px-4">
			<h1 class="text-4xl md:text-5xl font-bold text-white mb-4 uppercase tracking-wider">
				Production <span class="text-accent">Gallery</span>
			</h1>
			<p class="text-gray-400 max-w-2xl mx-auto">
				Browse our diverse range of manufactured components and fabrication works.
			</p>
		</div>
	</section>

	<!-- GALLERY GRID -->
	<section class="py-20 bg-primary-light min-h-screen">
		<div class="container mx-auto px-4">
			
			<!-- Filters -->
			<div class="grid grid-cols-6 gap-2 md:flex md:flex-wrap md:justify-center md:gap-4 mb-12">
				<button class="col-span-2 filter-btn active px-2 md:px-6 py-2 rounded-full border border-accent text-accent font-bold text-xs md:text-sm uppercase transition w-full md:w-auto" data-filter="all">All Items</button>
				<button class="col-span-2 filter-btn px-2 md:px-6 py-2 rounded-full border border-gray-600 text-gray-300 hover:border-accent hover:text-accent font-bold text-xs md:text-sm uppercase transition w-full md:w-auto" data-filter="machining">Machining</button>
				<button class="col-span-2 filter-btn px-2 md:px-6 py-2 rounded-full border border-gray-600 text-gray-300 hover:border-accent hover:text-accent font-bold text-xs md:text-sm uppercase transition w-full md:w-auto" data-filter="fittings">Fittings</button>
				<button class="col-span-2 col-start-2 filter-btn px-2 md:px-6 py-2 rounded-full border border-gray-600 text-gray-300 hover:border-accent hover:text-accent font-bold text-xs md:text-sm uppercase transition w-full md:w-auto" data-filter="fabrication">Fabrication</button>
				<button class="col-span-2 filter-btn px-2 md:px-6 py-2 rounded-full border border-gray-600 text-gray-300 hover:border-accent hover:text-accent font-bold text-xs md:text-sm uppercase transition w-full md:w-auto" data-filter="casting">Casting</button>
			</div>

			<!-- Grid -->
			<div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-8">
				{galleryItems.map((item) => (
					<div class="gallery-item group relative rounded-lg bg-gray-900 border border-gray-800 overflow-hidden" data-category={item.category}>
						<div class="aspect-video overflow-hidden">
							<img src={item.image} alt={item.title} class="w-full h-full object-cover transition duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100" />
						</div>
						<div class="p-4 border-t border-gray-800">
							<h4 class="text-lg font-bold text-white">{item.title}</h4>
							<p class="text-xs text-gray-400 mt-1">{item.desc}</p>
						</div>
					</div>
				))}
			</div>

		</div>
	</section>

    <CtaSection />

</Layout>

<script>
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.gallery-item');

    buttons.forEach(btn => {
        btn.addEventListener('click', () => {
            buttons.forEach(b => {
                b.classList.remove('text-accent', 'border-accent');
                b.classList.add('text-gray-300', 'border-gray-600');
            });
            btn.classList.add('text-accent', 'border-accent');
            btn.classList.remove('text-gray-300', 'border-gray-600');

            const filter = btn.getAttribute('data-filter');
            items.forEach(item => {
                if (filter === 'all' || item.getAttribute('data-category') === filter) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
        });
    });
</script>