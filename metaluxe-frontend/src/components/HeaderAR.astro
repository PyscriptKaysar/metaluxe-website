---
import { Phone, Mail, Menu, X } from 'lucide-react';
---

<!-- 1. Top Bar -->
<div class="bg-primary-light border-b border-gray-700 text-xs py-2">
    <div class="container mx-auto px-4 flex justify-between items-center text-gray-400">
        <div class="flex gap-4">
            <a href="tel:+97126228826" class="flex items-center hover:text-accent transition">
                <span class="mr-1" dir="ltr">+971 2 622 88 26</span> <Phone className="w-3 h-3 ml-1" />
            </a>
            <a href="mailto:services@metaluxeuae.com" class="hidden md:flex items-center hover:text-accent transition">
                services@metaluxeuae.com <Mail className="w-3 h-3 ml-1" />
            </a>
        </div>
        <div class="flex gap-4">
            <span class="hidden xs:inline text-gray-500">أبو ظبي، الإمارات</span>
            <a href="/" class="hover:text-white font-bold">English</a>
        </div>
    </div>
</div>

<!-- 2. Main Navigation -->
<header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
    <div class="container mx-auto px-4 py-4 flex justify-between items-center">
        
        <!-- Logo -->
        <a href="/ar" class="flex items-center">
            <img 
                src="/images/metaluxe.png" 
                alt="Metaluxe" 
                class="h-14 w-auto object-contain brightness-110 contrast-125" 
            />
        </a>

        <!-- Desktop Menu -->
        <nav class="hidden md:flex gap-8 items-center text-sm font-bold text-primary">
            <a href="/ar" class="hover:text-accent transition">الرئيسية</a>
            <a href="/ar/about" class="hover:text-accent transition">من نحن</a>
            <a href="/ar/services" class="hover:text-accent transition">خدماتنا</a>
            <a href="/ar/gallery" class="hover:text-accent transition">المعرض</a>
            <a href="/ar/projects" class="hover:text-accent transition">المشاريع</a>
            
            <a href="/ar/contact" class="bg-accent hover:bg-accent-hover text-primary font-bold py-2 px-6 rounded transition">
                اطلب عرض سعر
            </a>
        </nav>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn-ar" class="md:hidden text-primary p-2" aria-label="Toggle Menu">
            <Menu className="w-8 h-8" />
        </button>

    </div>

    <!-- Mobile Menu Overlay (Hidden by default) -->
    <!-- RTL: -translate-x-full hides it to the left side -->
    <div id="mobile-menu-ar" class="fixed inset-0 bg-white z-[60] transform -translate-x-full transition-transform duration-300 md:hidden flex flex-col text-right" dir="rtl">
        
        <!-- Header inside Menu -->
        <div class="flex justify-between items-center p-4 border-b border-gray-100 flex-row-reverse">
            <!-- Close button on the right (visually left in RTL logic if row-reversed, but we want X where the menu button was?) -->
            <!-- Actually, let's keep it simple: Close button usually matches the open button position or top corner -->
            <!-- In RTL, top-left is the "end" usually. Let's just put components: Logo (Right), Close (Left) -->
            
            <a href="/ar" class="flex items-center">
               <!-- Logo -->
                <img 
                    src="/images/metaluxe.png" 
                    alt="Metaluxe" 
                    class="h-12 w-auto object-contain" 
                />
            </a>
            <button id="close-menu-btn-ar" class="text-primary p-2">
                <X className="w-8 h-8" />
            </button>
        </div>

        <!-- Links -->
        <div class="flex-grow flex flex-col justify-center items-center gap-8 text-xl font-bold text-primary">
            <a href="/ar" class="hover:text-accent transition mobile-link-ar">الرئيسية</a>
            <a href="/ar/about" class="hover:text-accent transition mobile-link-ar">عن الشركة</a>
            <a href="/ar/services" class="hover:text-accent transition mobile-link-ar">خدماتنا</a>
            <a href="/ar/gallery" class="hover:text-accent transition mobile-link-ar">المعرض</a>
            <a href="/ar/projects" class="hover:text-accent transition mobile-link-ar">المشاريع</a>
            
            <a href="/ar/contact" class="bg-accent text-primary px-8 py-3 rounded mt-4 mobile-link-ar">
                اطلب عرض سعر
            </a>
        </div>

        <!-- Footer inside Menu -->
        <div class="p-8 border-t border-gray-100 text-center text-gray-500 text-sm">
            <a href="/" class="text-primary border border-gray-300 px-4 py-2 rounded mb-4 inline-block hover:border-accent hover:text-accent">
                Switch to English / الانجليزية
            </a>
            <p>ميتالوكس للأعمال الهندسية &copy; {new Date().getFullYear()}</p>
        </div>

    </div>

</header>

<script>
    const menuBtnAr = document.getElementById('mobile-menu-btn-ar');
    const closeBtnAr = document.getElementById('close-menu-btn-ar');
    const mobileMenuAr = document.getElementById('mobile-menu-ar');
    const mobileLinksAr = document.querySelectorAll('.mobile-link-ar');

    function toggleMenuAr() {
        if (!mobileMenuAr) return;
        // Toggle the negative translate to slide from left
        mobileMenuAr.classList.toggle('-translate-x-full');
        document.body.classList.toggle('overflow-hidden');
    }

    if (menuBtnAr && closeBtnAr) {
        menuBtnAr.addEventListener('click', toggleMenuAr);
        closeBtnAr.addEventListener('click', toggleMenuAr);
        
        mobileLinksAr.forEach(link => {
            link.addEventListener('click', toggleMenuAr);
        });
    }
</script>