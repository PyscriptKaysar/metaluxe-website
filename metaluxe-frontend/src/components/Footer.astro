---
import { MapPin, Phone, Mail, Facebook, Instagram, ArrowRight } from 'lucide-react';
---

<footer class="bg-gray-900 border-t border-gray-800 text-gray-400 font-light pt-16 pb-8">
    <div class="container mx-auto px-4">
        
        <!-- Top Section: 4 Columns -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
            
            <!-- Column 1: Brand -->
            <div>
                <a href="/" class="text-2xl font-heading font-bold text-white tracking-wider block mb-6">
                    METALUXE<span class="text-accent">.</span>
                </a>
                <p class="mb-6 text-sm leading-relaxed">
                    Engineering excellence since 1992. Premier structural steel fabricators and machining specialists serving the UAE's industrial, marine, and oilfield sectors.
                </p>
                
                <!-- TWEAK 1 APPLIED HERE: Changed label to Affiliated Business -->
                <div class="p-4 bg-gray-800 rounded border border-gray-700">
                    <span class="text-xs font-bold text-accent uppercase block mb-1">Affiliated Business</span>
                    <p class="text-white text-sm font-bold">Crescent Gifts & Designing</p>
                    <span class="text-xs text-gray-500 mt-1 block">ADNOC ICV Certified</span>
                </div>
            </div>

            <!-- Column 2: Quick Links -->
            <div>
                <h3 class="text-white font-bold uppercase tracking-widest mb-6">Quick Links</h3>
                <ul class="space-y-3 text-sm">
                    <li><a href="/" class="hover:text-accent transition flex items-center"><ArrowRight className="w-3 h-3 mr-2" /> Home</a></li>
                    <li><a href="/about" class="hover:text-accent transition flex items-center"><ArrowRight className="w-3 h-3 mr-2" /> About</a></li>
                    <li><a href="/services" class="hover:text-accent transition flex items-center"><ArrowRight className="w-3 h-3 mr-2" /> Services</a></li>
                    <li><a href="/gallery" class="hover:text-accent transition flex items-center"><ArrowRight className="w-3 h-3 mr-2" /> Gallery</a></li>
                    <li><a href="/projects" class="hover:text-accent transition flex items-center"><ArrowRight className="w-3 h-3 mr-2" /> Projects</a></li>
                    <li><a href="/contact" class="hover:text-accent transition flex items-center"><ArrowRight className="w-3 h-3 mr-2" /> Get a Quote</a></li>
                </ul>
            </div>

            <!-- Column 3: Contact Info -->
            <div>
                <h3 class="text-white font-bold uppercase tracking-widest mb-6">Contact Us</h3>
                <ul class="space-y-4 text-sm">
                    <li class="flex items-start">
                        <MapPin className="w-5 h-5 text-accent mr-3 mt-0.5 shrink-0" />
                        <span>PO BOX 33646,<br/>Abu Dhabi, U.A.E</span>
                    </li>
                    <li class="flex items-center">
                        <Phone className="w-5 h-5 text-accent mr-3 shrink-0" />
                        <a href="tel:+97126228826" class="hover:text-white transition">+971 2 622 88 26</a>
                    </li>
                    <li class="flex items-center">
                        <Phone className="w-5 h-5 text-accent mr-3 shrink-0" />
                        <a href="tel:+971504135810" class="hover:text-white transition">+971 50 413 5810</a>
                    </li>
                    <li class="flex items-center">
                        <Mail className="w-5 h-5 text-accent mr-3 shrink-0" />
                        <a href="mailto:services@metaluxeuae.com" class="hover:text-white transition">services@metaluxeuae.com</a>
                    </li>
                </ul>
            </div>

            <!-- Column 4: Working Hours -->
            <div>
                <h3 class="text-white font-bold uppercase tracking-widest mb-6">Working Hours</h3>
                <ul class="space-y-3 text-sm mb-6">
                    <li class="flex justify-between">
                        <span>Mon - Sat:</span>
                        <span class="text-white">8:00 AM - 8:00 PM</span>
                    </li>
                    <li class="flex justify-between text-gray-500">
                        <span>Sunday:</span>
                        <span>Closed</span>
                    </li>
                </ul>
                
                <h3 class="text-white font-bold uppercase tracking-widest mb-4 text-xs">Follow Us</h3>
                <div class="flex gap-4">
                    <a href="#" class="p-2 bg-gray-800 rounded hover:bg-accent hover:text-primary transition" aria-label="Facebook"><Facebook className="w-5 h-5" /></a>
                    <a href="#" class="p-2 bg-gray-800 rounded hover:bg-accent hover:text-primary transition" aria-label="Instagram"><Instagram className="w-5 h-5" /></a>
                </div>
            </div>

        </div>

        <!-- Bottom Bar -->
        <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center text-xs">
            <p>&copy; {new Date().getFullYear()} Metaluxe Engineering & Fabrications. All rights reserved.</p>
            <div class="flex gap-6 mt-4 md:mt-0">
                <a href="#" class="hover:text-white transition">Privacy Policy</a>
                <a href="#" class="hover:text-white transition">Terms of Service</a>
            </div>
        </div>

    </div>
</footer>