---
import { MapPin, Phone, Mail, Facebook, Instagram, ArrowLeft } from 'lucide-react';
---

<footer class="bg-gray-900 border-t border-gray-800 text-gray-400 font-light pt-16 pb-8" dir="rtl">
    <div class="container mx-auto px-4">
        
        <!-- Top Section: 4 Columns -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
            
            <!-- Column 1: Brand -->
            <div>
                <a href="/ar" class="text-2xl font-heading font-bold text-white tracking-wider block mb-6">
                    ميتالوكس<span class="text-accent">.</span>
                </a>
                <p class="mb-6 text-sm leading-relaxed">
                    تميز هندسي منذ عام 1992. رواد تصنيع الهياكل الفولاذية وخدمات الخراطة المتخصصة لخدمة القطاعات الصناعية والبحرية وحقول النفط في الإمارات.
                </p>
                
                <div class="p-4 bg-gray-800 rounded border border-gray-700">
                    <span class="text-xs font-bold text-accent uppercase block mb-1">شركة شقيقة</span>
                    <p class="text-white text-sm font-bold">الهدايا الهلالية والتصميم</p>
                    <span class="text-xs text-gray-500 mt-1 block">معتمدة من أدنوك (ICV)</span>
                </div>
            </div>

            <!-- Column 2: Quick Links -->
            <div>
                <h3 class="text-white font-bold uppercase tracking-widest mb-6">راوبط سريعة</h3>
                <ul class="space-y-3 text-sm">
                    <li><a href="/ar" class="hover:text-accent transition flex items-center"><ArrowLeft className="w-3 h-3 ml-2" /> الرئيسية</a></li>
                    <li><a href="/ar/about" class="hover:text-accent transition flex items-center"><ArrowLeft className="w-3 h-3 ml-2" /> من نحن</a></li>
                    <li><a href="/ar/services" class="hover:text-accent transition flex items-center"><ArrowLeft className="w-3 h-3 ml-2" /> خدماتنا</a></li>
                    <li><a href="/ar/gallery" class="hover:text-accent transition flex items-center"><ArrowLeft className="w-3 h-3 ml-2" /> المعرض</a></li>
                    <li><a href="/ar/projects" class="hover:text-accent transition flex items-center"><ArrowLeft className="w-3 h-3 ml-2" /> المشاريع</a></li>
                    <li><a href="/ar/contact" class="hover:text-accent transition flex items-center"><ArrowLeft className="w-3 h-3 ml-2" /> اطلب عرض سعر</a></li>
                </ul>
            </div>

            <!-- Column 3: Contact Info -->
            <div>
                <h3 class="text-white font-bold uppercase tracking-widest mb-6">تواصل معنا</h3>
                <ul class="space-y-4 text-sm">
                    <li class="flex items-start">
                        <MapPin className="w-5 h-5 text-accent ml-3 mt-0.5 shrink-0" />
                        <span>ص.ب 33646،<br/>أبو ظبي، الإمارات العربية المتحدة</span>
                    </li>
                    <li class="flex items-center">
                        <Phone className="w-5 h-5 text-accent ml-3 shrink-0" />
                        <a href="tel:+97126228826" class="hover:text-white transition" dir="ltr">+971 2 622 88 26</a>
                    </li>
                    <li class="flex items-center">
                        <Phone className="w-5 h-5 text-accent ml-3 shrink-0" />
                        <a href="tel:+971504135810" class="hover:text-white transition" dir="ltr">+971 50 413 5810</a>
                    </li>
                    <li class="flex items-center">
                        <Mail className="w-5 h-5 text-accent ml-3 shrink-0" />
                        <a href="mailto:services@metaluxeuae.com" class="hover:text-white transition">services@metaluxeuae.com</a>
                    </li>
                </ul>
            </div>

            <!-- Column 4: Working Hours -->
            <div>
                <h3 class="text-white font-bold uppercase tracking-widest mb-6">ساعات العمل</h3>
                <ul class="space-y-3 text-sm mb-6">
                    <li class="flex justify-between">
                        <span>الاثنين - السبت:</span>
                        <span class="text-white" dir="ltr">8:00 AM - 8:00 PM</span>
                    </li>
                    <li class="flex justify-between text-gray-500">
                        <span>الأحد:</span>
                        <span>مغلق</span>
                    </li>
                </ul>
                
                <h3 class="text-white font-bold uppercase tracking-widest mb-4 text-xs">تابغنا</h3>
                <div class="flex gap-4">
                    <a href="#" class="p-2 bg-gray-800 rounded hover:bg-accent hover:text-primary transition" aria-label="Facebook"><Facebook className="w-5 h-5" /></a>
                    <a href="#" class="p-2 bg-gray-800 rounded hover:bg-accent hover:text-primary transition" aria-label="Instagram"><Instagram className="w-5 h-5" /></a>
                </div>
            </div>

        </div>

        <!-- Bottom Bar -->
        <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center text-xs">
            <p>&copy; {new Date().getFullYear()} ميتالوكس للهندسة وتصنيع المعادن. جميع الحقوق محفوظة.</p>
            <div class="flex gap-6 mt-4 md:mt-0">
                <a href="#" class="hover:text-white transition">سياسة الخصوصية</a>
                <a href="#" class="hover:text-white transition">شروط الخدمة</a>
            </div>
        </div>

    </div>
</footer>