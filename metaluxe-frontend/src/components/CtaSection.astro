---
import { Phone, ArrowRight } from 'lucide-react';
---

<section class="py-24 bg-primary relative overflow-hidden border-t border-gray-800">
    
    <!-- Background Gradient (Spotlight Effect) -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-gray-800/50 via-primary to-primary pointer-events-none"></div>

    <div class="container mx-auto px-4 relative z-10 text-center">
        
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
            Ready to Start Your Project?
        </h2>
        
        <p class="text-gray-400 text-lg max-w-2xl mx-auto mb-12">
            From custom machining to heavy structural steel fabrication, our team in Abu Dhabi is ready to deliver.
        </p>

        <div class="flex flex-col md:flex-row gap-8 justify-center items-center">
            
            <!-- Button 1: Quote -->
            <a href="/contact" class="bg-accent hover:bg-accent-hover text-primary font-bold py-4 px-10 rounded shadow-lg shadow-accent/10 transition transform hover:scale-105 flex items-center">
                Get a Free Quote <ArrowRight className="ml-2 w-5 h-5"/>
            </a>

            <!-- Button 2: Call -->
            <a href="tel:+97126228826" class="flex items-center group">
                <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center mr-4 group-hover:bg-accent group-hover:text-primary transition duration-300">
                    <Phone className="w-5 h-5 text-white group-hover:text-primary transition"/>
                </div>
                <div class="text-left">
                    <span class="block text-xs text-gray-500 font-bold uppercase tracking-wide group-hover:text-accent transition">Speak to an Engineer</span>
                    <span class="text-xl font-bold text-white">+971 2 622 88 26</span>
                </div>
            </a>

        </div>
    </div>
</section>