---
import { ArrowRight } from 'lucide-react';

const projects = [
  {
    title: "Offshore Welding Support",
    category: "Marine & Offshore",
    // Image: Man welding with sparks
    image: "https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&q=80&w=800",
    desc: "Fabrication of structural support beams for offshore drilling rigs."
  },
  {
    title: "Government Infrastructure",
    category: "Structural Projects",
    // Image: Park/Public Space placeholder (using generic architecture/structure image for now)
    image: "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&q=80&w=800",
    desc: "Fabrication and installation of structural sign boards, park benches, and public facilities."
  },
  {
    title: "Oilfield Component Manufacturing",
    category: "Oil & Gas",
    // Image: Industrial valve/drill
    image: "https://images.unsplash.com/photo-1581093458791-9f302e6d8a6b?auto=format&fit=crop&q=80&w=800",
    desc: "Precision machining of specialized downhole tools and drill components."
  }
];
---

<!-- Keep the rest of the file exactly the same below this line -->
<section class="py-20 bg-primary-light border-t border-gray-800">
    <div class="container mx-auto px-4">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12">
            <div class="max-w-2xl">
                <span class="text-accent font-bold tracking-widest uppercase text-sm">Our Portfolio</span>
                <h2 class="text-4xl font-bold text-white mt-2">Recent Projects</h2>
            </div>
            <a href="/projects" class="hidden md:flex items-center text-white hover:text-accent transition mt-4 md:mt-0">
                View All Projects <ArrowRight className="w-5 h-5 ml-2" />
            </a>
        </div>

        <!-- Project Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {projects.map((project) => (
                <div class="group relative overflow-hidden rounded-lg cursor-pointer h-64">
                    
                    <!-- Image -->
                    <div class="absolute inset-0">
                        <img 
                            src={project.image} 
                            alt={project.title}
                            class="w-full h-full object-cover transition duration-700 group-hover:scale-110"
                        />
                    </div>

                    <!-- Overlay Content -->
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/95 via-primary/40 to-transparent flex flex-col justify-end p-6 translate-y-4 group-hover:translate-y-0 transition duration-300">
                        <span class="text-accent text-xs font-bold uppercase tracking-wider mb-2">
                            {project.category}
                        </span>
                        <h3 class="text-xl font-bold text-white mb-1">{project.title}</h3>
                        <p class="text-gray-300 text-sm opacity-0 group-hover:opacity-100 transition duration-300 delay-100 line-clamp-2">
                            {project.desc}
                        </p>
                    </div>

                </div>
            ))}
        </div>

        <!-- Mobile View All -->
        <div class="mt-8 text-center md:hidden">
            <a href="/projects" class="bg-transparent border border-gray-600 text-white py-3 px-8 rounded hover:bg-white hover:text-primary transition">
                View All Projects
            </a>
        </div>

    </div>
</section>