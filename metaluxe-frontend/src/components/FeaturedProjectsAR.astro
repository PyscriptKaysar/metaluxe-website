---
import { ArrowLeft } from 'lucide-react';

const projects = [
  {
    title: "دعم اللحام البحري",
    category: "الخدمات البحرية والنفطية",
    // Image: Man welding with sparks
    image: "https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&q=80&w=800",
    desc: "تصنيع عوارض الدعم الهيكلية لمنصات الحفر البحرية."
  },
  {
    title: "البنية التحتية الحكومية",
    category: "المشاريع الإنشائية",
    // Image: Park/Public Space placeholder (using generic architecture/structure image for now)
    image: "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&q=80&w=800",
    desc: "تصنيع وتركيب اللوحات الإرشادية الهيكلية، ومقاعد الحدائق، والمرافق العامة."
  },
  {
    title: "تصنيع مكونات حقول النفط",
    category: "النفط والغاز",
    // Image: Industrial valve/drill
    image: "https://images.unsplash.com/photo-1581093458791-9f302e6d8a6b?auto=format&fit=crop&q=80&w=800",
    desc: "خراطة دقيقة لأدوات قاع البئر المتخصصة ومكونات الحفر."
  }
];
---

<section class="py-20 bg-primary-light border-t border-gray-800">
    <div class="container mx-auto px-4">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12">
            <div class="max-w-2xl text-right ml-auto order-1 md:order-2">
                <span class="text-accent font-bold tracking-widest uppercase text-sm block">معرض أعمالنا</span>
                <h2 class="text-4xl font-bold text-white mt-2">أحدث المشاريع</h2>
            </div>
            <a href="/ar/projects" class="hidden md:flex items-center text-white hover:text-accent transition mt-4 md:mt-0 order-2 md:order-1 gap-2">
                <ArrowLeft className="w-5 h-5" /> عرض جميع المشاريع 
            </a>
        </div>

        <!-- Project Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {projects.map((project) => (
                <div class="group relative overflow-hidden rounded-lg cursor-pointer h-64">
                    
                    <!-- Image -->
                    <div class="absolute inset-0">
                        <img 
                            src={project.image} 
                            alt={project.title}
                            class="w-full h-full object-cover transition duration-700 group-hover:scale-110"
                        />
                    </div>

                    <!-- Overlay Content -->
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/95 via-primary/40 to-transparent flex flex-col justify-end p-6 translate-y-4 group-hover:translate-y-0 transition duration-300 text-right">
                        <span class="text-accent text-xs font-bold uppercase tracking-wider mb-2">
                            {project.category}
                        </span>
                        <h3 class="text-xl font-bold text-white mb-1">{project.title}</h3>
                        <p class="text-gray-300 text-sm opacity-0 group-hover:opacity-100 transition duration-300 delay-100 line-clamp-2">
                            {project.desc}
                        </p>
                    </div>

                </div>
            ))}
        </div>

        <!-- Mobile View All -->
        <div class="mt-8 text-center md:hidden">
            <a href="/ar/projects" class="bg-transparent border border-gray-600 text-white py-3 px-8 rounded hover:bg-white hover:text-primary transition">
                عرض جميع المشاريع
            </a>
        </div>

    </div>
</section>
