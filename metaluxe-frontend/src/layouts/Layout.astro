---
import '../styles/global.css';
import Header from '../components/Header.astro';
import HeaderAR from '../components/HeaderAR.astro';
import Footer from '../components/Footer.astro';
import FooterAR from '../components/FooterAR.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro'; // <--- Import

interface Props {
	title: string;
	description?: string;
	lang?: string;
}

const { 
	title, 
	description = "Metaluxe - Steel Fabrication & Engineering Services in UAE",
	lang = "en" 
} = Astro.props;

const dir = lang === 'ar' ? 'rtl' : 'ltr';
const isArabic = lang === 'ar';
---

<!doctype html>
<html lang={lang} dir={dir} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | {isArabic ? "ميتالوكس الإمارات" : "Metaluxe UAE"}</title>
	</head>
	<body class={`bg-primary text-gray-100 antialiased min-h-screen flex flex-col ${isArabic ? 'font-arabic' : ''}`}>
		
		{isArabic ? <HeaderAR /> : <Header />}

		<main class="flex-grow">
			<slot />
		</main>

		{isArabic ? <FooterAR /> : <Footer />}

        <!-- Floating Button sits on top of everything -->
        <WhatsAppBtn /> 

	</body>
</html>