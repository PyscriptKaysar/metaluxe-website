---
import '../styles/global.css';
import Header from '../components/Header.astro';
import HeaderAR from '../components/HeaderAR.astro';
import Footer from '../components/Footer.astro';
import FooterAR from '../components/FooterAR.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro'; // <--- Import

interface Props {
	title: string;
	description?: string;
	lang?: string;
	canonical?: string;
	ogImage?: string;
	ogType?: "website" | "article";
}

const { 
	title, 
	description = "Metaluxe - Steel Fabrication & Engineering Services in UAE",
	lang = "en",
	canonical,
	ogImage,
	ogType = "website"
} = Astro.props;

const dir = lang === 'ar' ? 'rtl' : 'ltr';
const isArabic = lang === 'ar';
const siteName = isArabic ? "\\u0645\\u064a\\u062a\\u0627\\u0644\\u0648\\u0643\\u0633 \\u0627\\u0644\\u0625\\u0645\\u0627\\u0631\\u0627\\u062a" : "Metaluxe UAE";
const siteUrl = Astro.site ?? new URL("https://metaluxeuae.com");
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage ?? "/images/metaluxe2.jpeg", siteUrl).toString();
const ogLocale = isArabic ? "ar_AE" : "en_AE";
---

<!doctype html>
<html lang={lang} dir={dir} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | {siteName}</title>
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={`${title} | ${siteName}`} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={isArabic ? "\\u0634\\u0639\\u0627\\u0631 \\u0645\\u064a\\u062a\\u0627\\u0644\\u0648\\u0643\\u0633" : "Metaluxe logo"} />
		<meta property="og:locale" content={ogLocale} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | ${siteName}`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
	</head>
	<body class={`bg-primary text-gray-100 antialiased min-h-screen flex flex-col ${isArabic ? 'font-arabic' : ''}`}>
		
		{isArabic ? <HeaderAR /> : <Header />}

		<main class="flex-grow">
			<slot />
		</main>

		{isArabic ? <FooterAR /> : <Footer />}

        <!-- Floating Button sits on top of everything -->
        <WhatsAppBtn /> 

	</body>
</html>
